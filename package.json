{
  "name": "@fahu/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Project-local Codex skills with pinned upstream imports",
  "type": "module",
  "bin": {
    "fahu-skills": "bin/fahu-skills.mjs"
  },
  "scripts": {
    "skills:build": "python3 skills/pstack/.bundle/scripts/export.py",
    "check": "python3 skills/pstack/.bundle/scripts/verify.py --require-all && node --test --test-reporter=dot skills/security-audit/validate-*.test.cjs"
  },
  "files": [
    "bin/",
    "skills/"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fahu/skills.git"
  }
}
